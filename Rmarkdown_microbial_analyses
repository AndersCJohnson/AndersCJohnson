#Decontam of ASVS using the combined method of the decontam package



```{r, decontam}
ASVs_raw <- read_tsv("ASV_table.tsv", 
  col_types = cols(.default = col_double(), seqid = col_character()))
ASVs_raw <- column_to_rownames(ASVs_raw, var = "seqid")

#define if sample is a control
neg_controls <- metadata$sample_type == "neg"

#run decontamination model 

#frequency based, if lacking negative controls but have extracted DNA concentrations
#contaminants_freq <- isContaminant(t(ASVs_raw), method = "frequency", conc = metadata$DNA_concentration, neg = neg_controls)

#prevelance based, if have negative controls, but lack DNA concentrations
#contaminants_prev <- isContaminant(t(ASVs_raw), method = "prevalence", conc = metadata$DNA_concentration, neg = neg_controls)

#combined freq and prev, use if having both negative controls and DNA concentrations

contaminants_comb <- isContaminant(t(ASVs_raw), method = "combined", conc = metadata$DNA_concentration, neg = neg_controls)


clean_counts_table <- ASVs_raw[!contaminants_comb$contaminant, ]
write.csv(clean_counts_table, "Figures/clean_counts.csv", row.names = TRUE)

clean_counts_table <- clean_counts_table %>% rownames_to_column("seqid")

ASVs_decontam <- clean_counts_table

contams_list <- contaminants_comb %>% 
  subset(contaminant == "TRUE") %>%
  rownames_to_column("seqid") %>%
  merge(taxonomy, by = "seqid")
write.csv(contams_list, "Figures/contaminants_list_method=DecontamCombined.csv")
```





