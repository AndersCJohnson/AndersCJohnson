# Merge boreZtp_asvs with taxonomy and metadata
final_table <- Control_asvs %>%
  inner_join(taxonomy, by = "seqid") %>%
  inner_join(Control_metadata, by = "sample") %>%
  group_by(common_name, Species) %>%
  summarise(total_count = sum(count), .groups = "drop") %>%
  ungroup()

# Identify the top 20 Species based on total counts across all common_name
top_Species <- final_table %>%
  group_by(Species) %>%
  summarise(total_species_count = sum(total_count), .groups = "drop") %>%
  arrange(desc(total_species_count)) %>%
  slice_head(n = 20) %>%
  pull(Species)

# Categorize Species as "Top 20" or "Other"
final_table <- final_table %>%
  mutate(Species = if_else(Species %in% top_Species, Species, "Other"),
         Species = if_else(is.na(Species), "Other", Species)) # Combine NA into "Other"

# Summarize again to combine all "Other" counts
final_table <- final_table %>%
  group_by(common_name, Species) %>%
  summarise(total_count = sum(total_count), .groups = "drop")

# Calculate relative abundances for each species within each common_name
final_table_relabs <- final_table %>%
  group_by(common_name) %>%
  mutate(relative_abundance = total_count / sum(total_count)) %>%
  ungroup()

# Reshape into wide format for absolute counts: row names = common_name, column names = Species, values = total counts
wide_table <- final_table %>%
  pivot_wider(names_from = Species, values_from = total_count, values_fill = 0)

# Reshape into wide format for relative abundances: row names = common_name, column names = Species, values = relative abundances
wide_table_relabs <- final_table_relabs %>%
  dplyr::select(common_name, Species, relative_abundance) %>%
  pivot_wider(names_from = Species, values_from = relative_abundance, values_fill = 0)

# Save outputs for inspection
