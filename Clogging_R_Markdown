#define colors for this plot, color blind safe
balloon_plot_colors <- c(
  "Borehole"     = "#1b9e77",
  "Biofilm_SS"   = "#d95f02",
  "Biofilm_Tef"  = "#7570b3",
  "Outlet_SS"    = "#e7298a",
  "Outlet_Tef"   = "#66a61e")



ggplot(balloon_plot_data, 
       aes(x = Incubation_time_yrs, 
           y = fct_relevel(`Gene ID`, !!!rev(Gene_ID_names_relevel)),
           size = ifelse(relab_adjusted > 0, relab_adjusted, NA),
           color = new_names)) +
  geom_point(alpha = .7) +
  
  facet_grid(
  `Pathway category` ~ factor(new_names, levels = c("Borehole","Biofilm_SS","Biofilm_Tef","Outlet_SS", "Outlet_Tef")),
# `Pathway category` ~ factor(Incubation_time_yrs, levels = c("0","1","2","3","4")),
  scales = "free",
  space  = "free",
  drop = FALSE) +
  
  scale_size_continuous(name = "Mean Relab %",
                        range = c(0.01, 5),
                        #trans = "sqrt",
                        breaks = c(0.1, 0.5, 1, 2, 5, 10, 20))  +
  scale_color_manual(
    name = "Sample type",
    values = balloon_plot_colors) +
  
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    strip.background = element_rect(fill = "grey90"),
    strip.text.y = element_text(angle = 0))


