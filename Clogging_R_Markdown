```{r, decontam}
ASVs_decon_stage_0 <- read_tsv("Raw_data/Clogging_ASV_table.tsv", 
  col_types = cols(.default = col_double(), seqid = col_character()))
ASVs_decon_stage_0<- column_to_rownames(ASVs_decon_stage_0, var = "seqid")

metadata <- read_csv("Raw_data/Clogging_metadata.csv", 
  col_names = TRUE,
  col_types = cols(.default = col_double(),
    sample = col_character(),               
    Your_sample_name = col_character(),
    sampling_date = col_character(),
    sampling_year = col_character(),
    sample_source = col_character(),
    DNA_conc = col_number(),
    sample_type = col_character(),
    new_names = col_character(),
    Incubation_time_yrs = col_character())) 

#define if sample is a control
