###adjust for new code, tables of relative abundances
```{r}
# Merge asvs with taxonomy and metadata
final_table <- asvs_f %>%
  inner_join(taxonomy_f, by = "seqid") %>%
  inner_join(metadata, by = "sample") %>%
  group_by(Your_sample_name, Family) %>%
  summarise(total_count = sum(count), .groups = "drop") %>%
  ungroup()

# Identify the top 20 phyla based on total counts across all common_name
top_family <- final_table %>%
  group_by(Family) %>%
  summarise(total_family_count = sum(total_count), .groups = "drop") %>%
  arrange(desc(total_family_count)) %>%
  slice_head(n = 20) %>%
  pull(Family)

# Categorize phyla as "Top 20" or "Other"
final_table <- final_table %>%
  mutate(Family = if_else(Family %in% top_family, Family, "Other"),
         Family = if_else(is.na(Family), "Other", Family)) # Combine NA into "Other"

# Summarize again to combine all "Other" counts
final_table <- final_table %>%
  group_by(Your_sample_name, Family) %>%
  summarise(total_count = sum(total_count), .groups = "drop")

# Calculate relative abundances for each family within each common_name
final_table_relabs <- final_table %>%
  group_by(Your_sample_name) %>%
  mutate(relative_abundance = total_count / sum(total_count)) %>%
  ungroup()

# Reshape into wide format for absolute counts: row names = common_name, column names = Family, values = total counts
wide_table <- final_table %>%
  pivot_wider(names_from = Family, values_from = total_count, values_fill = 0)

wide_table <- wide_table %>%
  dplyr::slice(match(sample_names_relevel, Your_sample_name))

# Reshape into wide format for relative abundances: row names = common_name, column names = Family, values = relative abundances
wide_table_relabs <- final_table_relabs %>%
  dplyr::select(Your_sample_name, Family, relative_abundance) %>%
  pivot_wider(names_from = Family, values_from = relative_abundance, values_fill = 0)

wide_table_relabs <- wide_table_relabs %>%
  dplyr::slice(match(sample_names_relevel, Your_sample_name))

# Save outputs for inspection
write_csv(wide_table, "Results/Microbiology/Family/Tables/Your_sample_name_family_asv_counts_decontam_stage_0.csv")
write_csv(wide_table_relabs, "Results/Microbiology/Family/Tables/Your_sample_name_family_relative_abundances_decontam_stage_0.csv")

# Print previews
print(wide_table)
print(wide_table_relabs)

