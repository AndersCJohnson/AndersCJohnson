```{r assign-top10-genus-to-taxonomy}
# Start by finding the top 11 genus *on average* over the samples
asvs_g_decontamed_biofilm <- asvs_decontam_final_biofilm

g_decontamed_biofilm <- asvs_g_decontamed_biofilm %>%
  inner_join(taxonomy, by = 'seqid') %>%
  group_by(Genus, sample) %>%
  # Calculate the relative abundance of each genus in each sample
  summarise(relab = sum(relab)) %>%
  # Calculate the *mean* relative abundance of each genus over the samples
  summarise(mean_relab = sum(relab)) %>%
  ungroup() %>%
  # Filter out non-assigned genus
  filter(!is.na(Genus)) %>%
  # Select the top 11
  top_n(20, mean_relab)

# Add this information to the taxonomy table as the column topgenus
taxonomy_g_decontamed_biofilm <- taxonomy %>%
  # Join in the top 10 table. *Important* with left join, otherwise you loose rows in the
  # taxonomy table that do not appear in the top 11 table.
  left_join(
    g_decontamed_biofilm %>% 
      # Duplicate the genus column, with the old name and as "topgenus"
      transmute(Genus, topgenus = Genus),
    by = 'Genus'
  ) %>%
  # Set topgenus to 'Other' for those that were not among the top 11
  replace_na(list('topgenus' = 'Other'))
